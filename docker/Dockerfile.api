FROM python:3.12-slim

WORKDIR /workspace

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    libpq-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

COPY services/api/requirements.runtime.txt /workspace/services/api/requirements.runtime.txt
COPY services/api/requirements.ml.txt /workspace/services/api/requirements.ml.txt
RUN pip install --no-cache-dir -r /workspace/services/api/requirements.runtime.txt

ARG INSTALL_ML=false
RUN if [ "$INSTALL_ML" = "true" ]; then \
      pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch && \
      pip install --no-cache-dir -r /workspace/services/api/requirements.ml.txt; \
    fi

COPY . /workspace

ENV PYTHONPATH=/workspace/services/api:/workspace

WORKDIR /workspace/services/api

EXPOSE 8000
RUN chmod +x /workspace/docker/entrypoint.sh
CMD ["/workspace/docker/entrypoint.sh"]
