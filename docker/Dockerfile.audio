FROM python:3.12-slim

WORKDIR /workspace
RUN apt-get update && apt-get install -y --no-install-recommends curl ffmpeg && rm -rf /var/lib/apt/lists/*

COPY services/api/requirements.runtime.txt /workspace/services/api/requirements.runtime.txt
COPY services/api/requirements.audio.txt /workspace/services/api/requirements.audio.txt
RUN pip install --no-cache-dir fastapi uvicorn[standard] python-multipart pydantic httpx pydantic-settings SQLAlchemy \
    && pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch \
    && pip install --no-cache-dir -r /workspace/services/api/requirements.audio.txt

COPY services /workspace/services
ENV PYTHONPATH=/workspace/services/api:/workspace
# Models download to this volume on first use (~400 MB for whisper base + pocket-tts).
VOLUME ["/root/.cache/huggingface"]
EXPOSE 8790
CMD ["uvicorn", "services.audio.app:app", "--host", "0.0.0.0", "--port", "8790"]
