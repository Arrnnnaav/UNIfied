# Unified Learning Platform - environment template
ENVIRONMENT=development
LOG_LEVEL=INFO

# Auth
JWT_SECRET_KEY=change-me-in-production-please
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Set only during initial operator provisioning, then rotate/remove it.
OPERATOR_BOOTSTRAP_TOKEN=

# Database (local dev outside docker)
DATABASE_URL=postgresql+psycopg://lp:lp@localhost:5432/learning_platform
POSTGRES_USER=lp
POSTGRES_PASSWORD=lp
POSTGRES_DB=learning_platform

# Redis
REDIS_URL=redis://localhost:6379/0

# Object storage (MinIO locally)
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=learning-platform
S3_ACCESS_KEY=lpminio
S3_SECRET_KEY=lpminiopass
MINIO_ROOT_USER=lpminio
MINIO_ROOT_PASSWORD=lpminiopass

# Embeddings (set INSTALL_ML=true and USE_LOCAL_EMBEDDINGS=true for the local sentence-transformer tier)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LOCAL_EMBEDDING_MODEL=
USE_LOCAL_EMBEDDINGS=false
EMBEDDING_DIMENSION=384

# LLM providers (optional; deterministic fallbacks used when unset)
CURRICULUM_MODEL=
ENRICHMENT_MODEL=
CONCEPT_MODEL=
ASSESSMENT_MODEL=
TUTOR_MODEL=
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.1:8b
LOCAL_VISION_MODEL=
LLM_TIMEOUT_SECONDS=12
LABEL_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Uploads
MAX_UPLOAD_MB=50
ASYNC_INGESTION=false

# Feature flags
FEATURE_TUTOR=true
FEATURE_GITHUB_INGESTION=true
FEATURE_YOUTUBE_INGESTION=false
FEATURE_KNOWLEDGE_MAP=true
